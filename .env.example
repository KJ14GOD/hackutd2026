# Copy to .env and fill in. Never commit .env.

# SpacetimeDB. Local (default): `pnpm stdb:start`, no key needed.
# Hosted: STDB_SERVER=maincloud, STDB_URI=wss://maincloud.spacetimedb.com, and a unique
# STDB_DB name (Maincloud names are global). Publishing there needs the native CLI + `spacetime login`.
STDB_SERVER=http://localhost:3000
STDB_URI=ws://localhost:3000
STDB_DB=theseus
# Optional identity token for services (printed on first connect). Empty = anonymous identity.
STDB_TOKEN=

# Legacy runtime: auto | cobol | stub   (auto = cobol if the compiled binary exists)
LEGACY_RUNTIME=auto

# LLM (Milestone 2). Provider: mock | replay | nvidia
LLM_PROVIDER=mock
# Hosted NVIDIA API: key (nvapi-...) from build.nvidia.com -> profile -> API Keys.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
LLM_MODEL_FAST=nvidia/nemotron-3.5-bolt-e4b
LLM_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b
# Optional: self-hosted fast model (vLLM or NIM on Brev, OpenAI-compatible). Empty = hosted API.
# Example: http://localhost:8000/v1 through `brev port-forward`; model name as served by vLLM.
LLM_FAST_BASE_URL=
LLM_FAST_API_KEY=

# Slack (Milestone 2, Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Phase 3 people connectors (services/people). Each source falls back to fixtures/org when its key is missing.
# GitHub: GITHUB_TOKEN, or a logged-in gh CLI. The synthetic org's history lives in this repo:
GITHUB_ORG_REPO=KJ14GOD/harborcard-mainframe
# Jira Cloud: site URL, the Atlassian login email, and an API token (id.atlassian.com -> Security -> API tokens).
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=CARD
# Notion internal integration secret; share a page titled "Harbor Card wiki" with the integration.
NOTION_TOKEN=
# REST_MODE=replay rebuilds the org from cached API responses (.cache/rest) with no network.
REST_MODE=

# Jev decisions via OpenRouter (typesafe/jev-1.13), called only from the dev server (POST /api/jev).
OPENROUTER_API_KEY=
