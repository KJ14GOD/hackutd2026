# Copy to .env and fill in. Never commit .env.

# SpacetimeDB. Local (default): `pnpm stdb:start`, no key needed.
# Hosted: STDB_SERVER=maincloud, STDB_URI=wss://maincloud.spacetimedb.com, and a unique
# STDB_DB name (Maincloud names are global). Publishing there needs the native CLI + `spacetime login`.
STDB_SERVER=http://localhost:3000
STDB_URI=ws://localhost:3000
STDB_DB=theseus
# Optional identity token for services (printed on first connect). Empty = anonymous identity.
STDB_TOKEN=

# Legacy runtime: auto | cobol | stub   (auto = cobol if the compiled binary exists)
LEGACY_RUNTIME=auto

# LLM (Milestone 2). Provider: mock | replay | nvidia
LLM_PROVIDER=mock
# Hosted NVIDIA API key (nvapi-...): org.ngc.nvidia.com/setup/api-keys -> Generate Personal Key,
# tick "Public API Endpoints" and "NGC Catalog". Free tier: up to 40 requests/min.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
LLM_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODEL_STRONG=nvidia/nemotron-3.5-super-vl-120b-a12b
# Optional: self-hosted fast model on Brev (NIM, OpenAI-compatible). Empty = hosted API.
# With `brev port-forward <instance> --port 8000:8000` running: http://localhost:8000/v1
# The NIM serves the model as nvidia/nemotron-3.5-lightning (set LLM_MODEL_FAST to that too).
LLM_FAST_BASE_URL=
LLM_FAST_API_KEY=

# Slack (Milestone 2, Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
