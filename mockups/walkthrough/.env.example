# GitHub sign-in. Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/auth/github/callback
# Then copy this file to .env and fill in both values. Never commit .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional, only if you serve the app somewhere other than localhost:5173.
GITHUB_CALLBACK_URL=
