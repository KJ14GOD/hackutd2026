//PLJOB1   JOB (ACCT),CLASS=A
//STEP1    EXEC PGM=PLBATCH1,PARM='2026'
//INFILE   DD DISP=SHR,DSN=PL.INPUT
//OUTFILE  DD DISP=(NEW,CATLG,DELETE),
//            DSN=PL.OUTPUT(+1)
//SRTIN    DD DISP=SHR,DSN=PL.SRT.IN
//SRTOUT   DD DISP=(NEW,CATLG),DSN=PL.SRT.OUT
//STEP2    EXEC PGM=SORT
//SORTIN   DD DISP=SHR,DSN=PL.OUTPUT(0)
//SORTOUT  DD DISP=(NEW,CATLG),DSN=PL.SORTED
//SYSIN    DD *
 SORT FIELDS=(1,10,CH,A)
/*
//STEP3    EXEC PGM=IDCAMS
//IN1      DD DISP=SHR,DSN=PL.SORTED
//OUT1     DD DISP=OLD,DSN=PL.VSAM.KSDS
//SYSIN    DD *
  REPRO INFILE(IN1) OUTFILE(OUT1)
/*
//STEP4    EXEC PLPROC,HLQ=PLX
//PS1.DATAOUT DD DISP=(NEW,CATLG),DSN=PL.OVERRIDE
//STEP5    EXEC PGM=IKJEFT01
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(PLSUB2) PLAN(PLPLAN)
/*
//STEP6    EXEC PGM=FTP
//INPUT    DD *
put PL.SORTED
/*
